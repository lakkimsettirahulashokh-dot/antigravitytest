# ==============================================================================
# TechPath Git Ignore Rules
# ==============================================================================

# Environment Secrets & Private Keys (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
credentials.json
client_secret*.json
service-account*.json

# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Chrome Test Profiles & Browser Artifacts
scratch/chrome_test_profile*

# System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Root Git Internal Artifacts (if unpacked in root)
/HEAD
/config
/description
/COMMIT_EDITMSG
/index
/objects/
/refs/
/hooks/
/info/
