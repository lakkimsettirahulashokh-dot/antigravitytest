# ==============================================================================
# TechPath — Production Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with live secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CORE CONFIGURATION (REQUIRED FOR DATABASE & AUTH)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Browser-Safe Public Publishable / Anon API Key
# CLIENT-SAFE ONLY: Used client-side IF AND ONLY IF PostgreSQL Row Level Security (RLS) is enabled on all tables.
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase Service Role Secret Key
# SERVER-SIDE ONLY: NEVER expose to the browser client or commit to git. Grants full admin bypass of RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. APPLICATION SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=8080
APP_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. AI PROVIDER INTEGRATION (SERVER-SIDE ONLY — NEVER LEAK TO CLIENT)
# ------------------------------------------------------------------------------
# OpenRouter API Key (multimodal models: Gemini, Claude, DeepSeek)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Google Gemini API Key (optional direct provider)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (optional fallback provider)
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
# Configure in Google Cloud Console & link in Supabase Authentication -> Providers -> Google
# Authorized Redirect URI in Supabase: https://<your-project-id>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ------------------------------------------------------------------------------
# 5. GOOGLE ADMOB / ADSENSE (OPTIONAL)
# ------------------------------------------------------------------------------
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_BANNER_UNIT=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
ADMOB_INTERSTITIAL_UNIT=ca-app-pub-xxxxxxxxxxxxxxxx/wwwwwwwwww

# ------------------------------------------------------------------------------
# 6. ADMINISTRATION & OFFICIAL SUPPORT EMAIL
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com
